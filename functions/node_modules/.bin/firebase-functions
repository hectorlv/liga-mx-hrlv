if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../firebase-functions/lib/bin/firebase-functions.js" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../firebase-functions/lib/bin/firebase-functions.js" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../firebase-functions/lib/bin/firebase-functions.js" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../firebase-functions/lib/bin/firebase-functions.js" "$@"
