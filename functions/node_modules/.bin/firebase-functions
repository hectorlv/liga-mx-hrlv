else
  export NODE_PATH="/Users/hectorrlv/Documents/lit-element/liga-mx-hrlv/node_modules/.pnpm/firebase-functions@6.6.0_firebase-admin@13.10.0_@firebase+app-compat@0.5.17_@firebase+a_89080e8d0b74a54d6e9795dc95fe1688/node_modules/firebase-functions/node_modules:/Users/hectorrlv/Documents/lit-element/liga-mx-hrlv/node_modules/.pnpm/firebase-functions@6.6.0_firebase-admin@13.10.0_@firebase+app-compat@0.5.17_@firebase+a_89080e8d0b74a54d6e9795dc95fe1688/node_modules:/Users/hectorrlv/Documents/lit-element/liga-mx-hrlv/node_modules/.pnpm/node_modules:$NODE_PATH"
