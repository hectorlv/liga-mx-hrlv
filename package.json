{
  "name": "liga-mx-hrlv",
  "description": "Web component liga-mx-hrlv following open-wc recommendations",
  "license": "MIT",
  "author": "liga-mx-hrlv",
  "version": "4.17.1",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,js,html}\" \"tools/**/*.mjs\"",
    "format": "eslint \"src/**/*.{ts,js,html}\" --fix && prettier \"src/**/*.{ts,js,html,css,json,md}\" --write",
    "build": "rimraf dist && rollup -c rollup.config.js --bundleConfigAsCjs && pnpm run analyze",
    "start:build:open": "pnpm run build && web-dev-server --root-dir dist --app-index index.html --open",
    "start:build": "pnpm run build && web-dev-server --root-dir dist --app-index index.html",
    "start": "web-dev-server --root-dir dist --app-index index.html",
    "mcp:app": "pnpm run build && web-dev-server --root-dir dist --app-index index.html --port 8011",
    "mcp:liga": "node tools/mcp/server.mjs",
    "test:mcp": "node --test tools/mcp/test/*.test.mjs",
    "test:mcp:browser": "node --test tools/mcp/integration/*.test.mjs",
    "typecheck": "tsc6 --noEmit",
    "analyze": "custom-elements-manifest analyze --globs \"src/**/*.{ts,js}\" --exclude \"**/dist/**\" --exclude \"**/node_modules/**\" --outdir dist"
  },
  "dependencies": {
    "@material/web": "^2.5.0",
    "firebase": "^12.19.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.6",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@open-wc/eslint-config": "^13.1.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@web/dev-server": "^1.0.0",
    "@web/rollup-plugin-html": "^4.0.0",
    "@web/rollup-plugin-import-meta-assets": "^3.0.0",
    "axe-core": "^4.13.0",
    "babel-plugin-template-html-minifier": "^4.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.5",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-workbox": "^9.0.0",
    "serialize-javascript": "^7.1.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "zod": "^4.6.5"
  },
  "eslintConfig": {
    "extends": [
      "@open-wc",
      "prettier"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "customElements": "dist/custom-elements.json",
  "overrides": {
    "glob": "11.1.0"
  }
}
